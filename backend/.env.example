# ---------------------------------------------------------------------------
# Culprit backend configuration. Copy to backend/.env (real shell env vars win).
#
# NO KEYS? Set CULPRIT_OFFLINE=1 and everything runs locally — real git, real
# benchmark timings; only the Nemotron reasoning is a labelled stand-in.
# ---------------------------------------------------------------------------

# --- Offline demo mode (no API keys needed) --------------------------------
# CULPRIT_OFFLINE=1

# --- Nebius Token Factory (inference + sandboxes share the API key) --------
NEBIUS_API_KEY=
# NEBIUS_API_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model IDs. Nebius documents more than one spelling for the Nemotron family,
# so don't guess: GET /preflight (or the "Backend ready" panel on /new) checks
# these against the LIVE catalog and prints the real Nemotron IDs if one is off.
# NEMOTRON_ULTRA_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b
# NEMOTRON_NANO_MODEL_ID=nvidia/nvidia-nemotron-3-nano-30b-a3b

# --- Sandboxes (Token Factory / ConTree) ------------------------------------
# 1 = every benchmark runs in a fresh, disposable, VM-isolated sandbox.
# 0/unset = LOCAL sandbox: benchmark commands execute on THIS machine. Fine for
# development; do not expose a local-sandbox backend to untrusted users.
USE_TOKEN_FACTORY=1
CONTREE_PROJECT=            # project ID with sandbox access (NEBIUS_AI_PROJECT also accepted)
# CONTREE_URL=https://api.tokenfactory.nebius.com/sandboxes
CONTREE_IMAGE=              # image UUID or tag:... with python3+git+pip (see `contree images`)

# --- Grounding ---------------------------------------------------------------
TAVILY_API_KEY=
# TAVILY_MIN_SCORE=0.2      # results Tavily scores below this are dropped, never cited

# --- Benchmark policy --------------------------------------------------------
# REGRESSION_THRESHOLD_PCT=15
# BENCHMARK_N_RUNS=5
# AUTO_RANGE_COMMITS=30     # when no commit range is given: last N first-parent commits
# MAX_CONCURRENT_JOBS=2     # extra jobs genuinely wait in "queued"

# --- Server -------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# HOST=127.0.0.1
# PORT=8000
# CULPRIT_DB=memory                  # default: SQLite at backend/.data/culprit.db (history survives restarts)
# CULPRIT_DATA_DIR=./.data
# CULPRIT_ALLOW_LOCAL_REPOS=1        # allow local-path repos while USE_TOKEN_FACTORY=1
# CULPRIT_MAX_DIFF_CHARS=150000      # caps so one huge diff can't blow the model's context
# CULPRIT_MAX_CONTEXT_CHARS=300000
