# --- Nebius Token Factory (inference + sandboxes share the API key) ---
NEBIUS_API_KEY=
# NEBIUS_API_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model IDs: copy exact IDs from the Token Factory model catalog
# NEMOTRON_NANO_MODEL_ID=
# NEMOTRON_ULTRA_MODEL_ID=

# --- Sandboxes (ConTree) ---
USE_TOKEN_FACTORY=1
CONTREE_PROJECT=            # project ID with sandbox access enabled
# CONTREE_URL=https://api.tokenfactory.nebius.com/sandboxes
CONTREE_IMAGE=              # image UUID or tag:... with python3+git+pip (see `contree images`)

TAVILY_API_KEY=
